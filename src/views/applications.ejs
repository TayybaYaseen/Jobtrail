<%- include("partials/header", { title: "JobTrail" }) %>
<h1>Applications</h1>

<form method="post" action="/applications" class="panel add-form">
  <label>Company <input name="company" required></label>
  <label>Role <input name="role" required></label>
  <label>Applied on <input name="applied_on" type="date" required></label>
  <% if (cvs.length > 0) { %>
  <label>CV sent
    <select name="cv_id">
      <option value="">No CV chosen</option>
      <% cvs.forEach((cv, i) => { %><option value="<%= cv.id %>" <%= i === 0 ? "selected" : "" %>><%= cv.name %> (added <%= niceDate(cv.addedOn) %>)</option><% }) %>
    </select>
  </label>
  <% } %>
  <button>Add</button>
</form>

<% if (apps.length === 0) { %>
<p class="muted">No applications yet. Add your first one above.</p>
<% } else { %>
<ul class="app-list">
  <% for (const app of apps) { %>
  <li class="app-card">
    <div class="app-card-head">
      <div>
        <h2><a class="card-link" href="/applications/<%= app.id %>"><%= app.company %></a></h2>
        <p class="role"><%= app.role %></p>
      </div>
      <span class="stage"><%= stageLabel(app.stage) %></span>
    </div>
    <dl class="dates">
      <dt>Applied</dt><dd><%= niceDate(app.appliedOn) %></dd>
      <dt>Next step</dt><dd><%= app.nextStepOn ? niceDate(app.nextStepOn) : "—" %></dd>
    </dl>
    <form method="post" action="/applications/<%= app.id %>/stage" class="stage-form">
      <label>Stage
        <select name="stage">
          <% for (const s of stages) { %><option value="<%= s %>" <%= s === app.stage ? "selected" : "" %>><%= stageLabel(s) %></option><% } %>
        </select>
      </label>
      <label>Next step date <input name="next_step_on" type="date" value="<%= app.nextStepOn ? toIso(app.nextStepOn) : "" %>"></label>
      <button>Save</button>
    </form>
  </li>
  <% } %>
</ul>
<% } %>
</main>
</body>
</html>
