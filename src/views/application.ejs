<%- include("partials/header", { title: `${app.company} · JobTrail` }) %>
<p class="back"><a href="/">← All applications</a></p>
<div class="app-card-head">
  <div>
    <h1><%= app.company %></h1>
    <p class="role"><%= app.role %></p>
  </div>
  <span class="stage"><%= stageLabel(app.stage) %></span>
</div>
<dl class="dates panel">
  <dt>Applied</dt><dd><%= niceDate(app.appliedOn) %></dd>
  <dt>Next step</dt><dd><%= app.nextStepOn ? niceDate(app.nextStepOn) : "—" %></dd>
  <% if (salaryRange(app)) { %><dt>Salary</dt><dd><%= salaryRange(app) %></dd><% } %>
  <% if (describeOffer(app)) { %><dt>Offer</dt><dd><%= describeOffer(app) %></dd><% } %>
  <dt>CV sent</dt><dd><% if (app.cv) { %><a href="/cvs/<%= app.cv.id %>"><%= app.cv.name %></a><% } else { %>No CV chosen<% } %></dd>
</dl>

<section class="panel prep-panel">
  <h2>Interview prep</h2>
  <% if (prep) { %>
  <p class="hint"><a href="/applications/<%= app.id %>/prep">See your interview prep</a> (made on <%= longDate(prep.createdOn) %>)</p>
  <% } else { %>
  <%- include("partials/prep-button", { app, cantPrep, label: "Prepare for interview" }) %>
  <% } %>
</section>

<% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
<% if (saved) { %><p class="saved" role="status">Saved</p><% } %>

<form method="post" action="/applications/<%= app.id %>" class="panel stacked-wide">
  <label>Job post <textarea name="job_post" rows="10">
<%= jobPost %></textarea></label>
  <label>CV sent
    <select name="cv_id">
      <option value="">No CV chosen</option>
      <% for (const cv of cvs) { %><option value="<%= cv.id %>" <%= cv.id === cvId ? "selected" : "" %>><%= cv.name %> (added <%= niceDate(cv.addedOn) %>)</option><% } %>
    </select>
  </label>
  <p class="hint"><a href="/cvs">Add a CV</a></p>
  <label>Minimum monthly salary (Rs) <input name="salary_min" inputmode="numeric" value="<%= salaryMin %>"></label>
  <label>Maximum monthly salary (Rs) <input name="salary_max" inputmode="numeric" value="<%= salaryMax %>"></label>
  <% if (app.stage === "offer") { %>
  <label>Monthly amount offered (Rs) <input name="salary_offered" inputmode="numeric" value="<%= salaryOffered %>"></label>
  <% } %>
  <button>Save</button>
</form>
</main>
</body>
</html>
