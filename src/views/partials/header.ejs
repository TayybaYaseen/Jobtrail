<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css">
  <script>
    // Sign up / Log in: disable the button while the form submits, so it can't be sent twice.
    document.addEventListener("submit", (e) => { if (e.target.matches("form.stacked")) e.submitter?.setAttribute("disabled", ""); });
    window.addEventListener("pageshow", () => document.querySelectorAll("form.stacked button").forEach((b) => b.removeAttribute("disabled")));
  </script>
</head>
<body>
  <nav class="site-nav">
    <div class="site-nav-inner">
      <span class="brand">JobTrail</span>
      <% if (locals.user) { %>
      <% for (const [href, label] of [["/", "Applications"], ["/this-week", "This Week"], ["/cvs", "CVs"]]) { %>
      <a href="<%= href %>"<% if (locals.currentPath === href) { %> aria-current="page"<% } %>><%= label %></a>
      <% } %>
      <form method="post" action="/logout"><button class="secondary">Log out</button></form>
      <% } %>
    </div>
  </nav>
  <main>
