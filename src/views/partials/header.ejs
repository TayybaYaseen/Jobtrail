<!doctype html>
<html lang="en"<% if (locals.theme === "light" || locals.theme === "dark") { %> data-theme="<%= locals.theme %>"<% } %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="<%= locals.theme === "light" || locals.theme === "dark" ? locals.theme : "light dark" %>">
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css">
  <script>
    // Sign up, Log in and Prepare for interview: disable the button while the form
    // submits, so it can't be sent twice. Prep also says it can take up to 30 seconds.
    document.addEventListener("submit", (e) => {
      if (!e.target.matches("form.stacked, form.prep-form")) return;
      e.submitter?.setAttribute("disabled", "");
      e.submitter?.setAttribute("data-busy", "");
      e.target.querySelector("[data-loading]")?.removeAttribute("hidden");
    });
    window.addEventListener("pageshow", () => {
      document.querySelectorAll("[data-busy]").forEach((b) => { b.removeAttribute("disabled"); b.removeAttribute("data-busy"); });
      document.querySelectorAll("[data-loading]").forEach((p) => p.setAttribute("hidden", ""));
    });
  </script>
</head>
<body>
  <nav class="site-nav">
    <div class="site-nav-inner">
      <span class="brand">JobTrail</span>
      <% if (locals.user) { %>
      <% for (const [href, label] of [["/", "Applications"], ["/this-week", "This Week"], ["/cvs", "CVs"], ["/referrals", "Referrals"], ["/settings", "Settings"]]) { %>
      <a href="<%= href %>"<% if (locals.currentPath === href) { %> aria-current="page"<% } %>><%= label %></a>
      <% } %>
      <form method="post" action="/logout"><button class="secondary">Log out</button></form>
      <% } %>
    </div>
  </nav>
