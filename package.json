{
  "name": "jobtrail",
  "version": "0.2.0",
  "description": "Track your job applications. Built by Zara during her own job hunt.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:demo": "node --env-file=demo.env --watch src/server.js",
    "digest": "node scripts/weekly-digest.js",
    "digest:demo": "node --env-file=demo.env scripts/weekly-digest.js",
    "import-json": "node scripts/import-json.js",
    "test": "vitest run",
    "lint": "eslint .",
    "eval:prep": "node scripts/eval-prep.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "better-sqlite3": "^13.0.3",
    "ejs": "^3.1.10",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "globals": "^16.0.0",
    "supertest": "^7.1.0",
    "vitest": "^5.0.5"
  }
}
